########################################
### LANZAR APLICACIONES
########################################

# Abrir ncmpcpp - Super + Alt + n
bindsym $mod+$alt+n exec kitty -e ncmpcpp

# Abrir rmpc - Super + Alt + r
bindsym $mod+$alt+r exec kitty -e rmpc --config ~/.config/rmpc/config.ron

# Abrir pcmanfm - Super + Alt + f
# bindsym $mod+$alt+f exec pcmanfm

# Abrir pcmanfm sin modo escritorio y asegurando que no se cuelgue la sesión
bindsym $mod+$alt+f exec pcmanfm --no-desktop

# Matar instancias colgadas de pcmanfm
bindsym $mod+Shift+f exec killall -9 pcmanfm

# Abrir firefox - Super + Alt + i
# Limpia el bloqueo, mata procesos huérfanos y lanza Firefox en Wayland nativo
bindsym $mod+$alt+i exec "pkill -9 firefox; rm -f ~/.mozilla/firefox/trbbdhie.default-esr/.parentlock ~/.mozilla/firefox/trbbdhie.default-esr/places.sqlite-wal; MOZ_ENABLE_WAYLAND=1 firefox"

# Abrir jdownloader - Super + Alt + j
bindsym $mod+$alt+j exec ~/.config/bin/jdownloader

# Abrir menú de power
bindsym $mod+$alt+p exec ~/.config/rofi/powermenu/type-1/executable_powermenu.sh

# Abrir MegaBasterd - Super + Alt + m
bindsym $mod+$alt+m exec ~/.config/bin/launch-megabasterd
#bindsym $mod+$alt+m exec env DISPLAY=$DISPLAY WAYLAND_DISPLAY=$WAYLAND_DISPLAY _JAVA_AWT_WM_NONREPARENTING=1 sh -c "cd /mnt/Nueva/SOFTWARE/MegaBasterd/ && ./MegaBasterd.run"

# Ejecutar tinyMediaManager
bindsym $mod+Shift+t exec /mnt/Nueva/Applications/Binarios/tinyMediaManager/tinyMediaManager

