# --- Tema y Colores (Corregido a minúsculas) ---
theme = carbonfox

# Tus colores personalizados heredados de tu color.ini de Kitty:
background = 000000
foreground = a9b1d6
#cursor-color = c0caf5
#cursor-text-color = 1a1b26
cursor-color = #c0caf5
cursor-text = #1a1b26

selection-background = 28344a
selection-foreground = 7aa2f7

# Paleta de colores exacta de tu Kitty:
palette = 0=#414868
palette = 8=#414868
palette = 1=#f7768e
palette = 9=#f7768e
palette = 2=#73daca
palette = 10=#73daca
palette = 3=#e0af68
palette = 11=#e0af68
palette = 4=#7aa2f7
palette = 12=#7aa2f7
palette = 5=#ff79c6
palette = 13=#ff92df
palette = 6=#7dcfff
palette = 14=#7dcfff
palette = 7=#bcbcbc
palette = 15=#c0caf5

# --- Tipografía (Cambiado a Iosevka como querías) ---
font-family = "Hack Nerd Font"
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 12

# --- Diseño, Márgenes y Bordes Redondeados ---
# Esto soluciona que el texto esté muy pegado al borde (equivalente a tu window_padding_width 10)
window-padding-x = 10
window-padding-y = 10

# Opacidad del fondo (como tenías en Kitty a 0.90)
background-opacity = 0.90

# Para Sway, desactivamos la decoración del sistema y usamos esquinas redondeadas en la terminal
window-decoration = false

# --- Cursor y Ratón (Tus preferencias de Kitty) ---
# En Kitty usabas 'beam' (barra/I-beam). Aquí se configura así:
cursor-style = bar
cursor-style-blink = false
cursor-invert-fg-bg = true
mouse-hide-while-typing = true

# --- Comportamiento y Shell (Configurado a Zsh como tenías en tu Kitty) ---
command = /bin/zsh
copy-on-select = clipboard
minimum-contrast = 1.05

# --- Atajos de teclado (Tus comandos para moverte entre divisiones/ventanas) ---
# Equivalente a tus mapeos 'neighboring_window' de Kitty con Ctrl + Flechas
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down

# Abrir nuevas divisiones o pestañas manteniendo el directorio actual (CWD)
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+t=new_tab

