{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#9c9898",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "color": "#f1c232",
    "italic": true,
    "indent_token": "┃"
  },
  "paragraph": {"indent": 2},
  "list": {
    "indent": 2,
    "color": "#9c9898",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#bb9af7",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "228",
    "background_color": "63",
    "bold": true
  },
  "h2": {
    "text_align": "center",
    "block_prefix": "\n",
    "block_suffix": "\n",
    "prefix": "▶ ",
    "color": "#45f3de",
    "background_color": "235"
  },
  "h3": {
    "indent": 2,
    "prefix": "▷ ",
    "color": "#2ac3de",
    "background_color": "235"
  },
  "h4": {
    "indent": 2,
    "prefix": "#### "
  },
  "h5": {
    "indent": 4,
    "prefix": "##### "
  },
  "h6": {
    "indent": 5,
    "prefix": "###### "
  },
  "text": {},
    "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "color": "#bcbcbc",
    "bold": true
  },
  "hr": {
    "color": "#565f89",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "indent": 2,
    "block_prefix": ". ",
    "color": "#7aa2f7"
  },
  "task": {
    "ticked": "[✔] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#7aa2f7",
    "underline": true,
    "block_prefix": "(",
    "block_suffix": ")"
  },
  "link_text": {
    "color": "#2ac3de"
  },
  "image": {
    "color": "#7aa2f7",
    "underline": true
  },
  "image_text": {
    "color": "#2ac3de",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "color": "#b570f7",
    "background_color": "235"
  },
  "code_block": {
    "color": "#ff9e64",
    "theme": "friendly",
    "margin": 4
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
