layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }    
    pane name="ansible-shell" {
        command "ssh"
        // El parámetro -t fuerza la creación de una TTY
        // Ejecutamos el cd y lanzamos una shell interactiva al final
        args "-t" "ansible@localhost" "cd /home/ansible/ansible-project/ansible-vampire && bash --login"
        focus true
    }
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}
